def predict_service_load(date_str):
    """
    Predicts the biometric service load for a given date.
    Input: Date string 'YYYY-MM-DD'
    """
    date_obj = pd.to_datetime(date_str)
    
    # Create features for the input date
    features = pd.DataFrame({
        'day_of_week': [date_obj.dayofweek],
        'day_of_month': [date_obj.day],
        'month': [date_obj.month],
        'is_start_of_month': [1 if date_obj.day == 1 else 0]
    })
    
    predicted_load = model.predict(features)[0]
    
    # Thresholds based on our EDA
    status = "NORMAL"
    if predicted_load > 5_000_000:
        status = "CRITICAL - SURGE EXPECTED"
    elif predicted_load > 1_000_000:
        status = "HIGH"
        
    return {
        "Date": date_str,
        "Predicted_Transactions": f"{int(predicted_load):,}",
        "System_Status": status
    }

